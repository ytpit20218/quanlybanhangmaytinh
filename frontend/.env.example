# Aiven MySQL Connection Configuration Template
# Provider: Aiven.io
# Engine: MySQL 8.4
# Project: COMPUTERTECH

AIVEN_MYSQL_HOST=your-mysql-host.aivencloud.com
AIVEN_MYSQL_PORT=28015
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=your_password_here
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_MYSQL_SSL=REQUIRED
AIVEN_MYSQL_URI=mysql://avnadmin:your_password_here@your-mysql-host.aivencloud.com:28015/defaultdb?ssl-mode=REQUIRED
